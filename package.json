{
  "name": "suburhoney-v2",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "optimize:images": "node scripts/optimize-images.mjs",
    "build": "npm run optimize:images && node scripts/ai/surfaces.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "ai:surfaces": "node scripts/ai/surfaces.mjs",
    "ai:facts": "node scripts/ai/facts-sync.mjs",
    "check:ai": "node scripts/ai/facts-sync.mjs --check",
    "ai:coverage": "node scripts/ai/coverage.mjs --facts AI-FACTS.yml",
    "ai:gate": "node scripts/ai/gate.mjs --url https://suburhoney.com",
    "ai:indexnow": "node scripts/ai/indexnow.mjs --sitemap",
    "ai:answers": "node scripts/ai/answer-blocks.mjs --list"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.3",
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "sharp": "^0.35.3"
  }
}

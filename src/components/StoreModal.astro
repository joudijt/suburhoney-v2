---
import type { Locale } from "../config/site";
import { SHOPEE_URL, TIKTOK_SHOP_URL } from "../config/site";
import en from "../i18n/locales/en/common.json";
import ar from "../i18n/locales/ar/common.json";
import ms from "../i18n/locales/ms/common.json";

const content = { en, ar, ms } as const;

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = content[lang].storeModal;
---

<div
  id="store-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-6 opacity-0 pointer-events-none"
  aria-hidden="true"
>
  <div id="store-modal-overlay" class="absolute inset-0 bg-brown/50 backdrop-blur-sm"></div>

  <div class="store-modal-panel relative w-full max-w-md overflow-hidden rounded-[2rem] bg-cream-soft p-8 shadow-2xl md:p-10">
    <img
      src="/images/honey-sticker.png"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute -top-2 end-[-1rem] h-20 w-auto rotate-[8deg] opacity-90 drop-shadow-xl md:-top-4 md:end-[-1.5rem] md:h-40"
    />

    <button
      id="store-modal-close"
      type="button"
      aria-label="Close"
      class="absolute end-4 top-4 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-cream text-brown/70 transition hover:bg-brown hover:text-cream-soft"
    >
      &times;
    </button>

    <div class="relative z-[1] max-w-[80%] space-y-2">
      <h3 class="font-display text-3xl text-brown md:text-4xl">{t.heading}</h3>
      <p class="text-brown/70">{t.subheading}</p>
    </div>

    <div class="relative z-[1] mt-8 space-y-4">
      <a
        href={SHOPEE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary block w-full rounded-xl text-center normal-case tracking-normal"
      >
        {t.shopee}
      </a>
      <a
        href={TIKTOK_SHOP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary block w-full rounded-xl text-center normal-case tracking-normal"
      >
        {t.tiktok}
      </a>
    </div>
  </div>
</div>

<script>
  import { initStoreModal } from "../scripts/store-modal";
  initStoreModal();
</script>

---
import { SHOPEE_URL, TIKTOK_SHOP_URL, type Locale } from "../config/site";

interface Props {
  lang: Locale;
  brand: string;
  description: string;
  badges: string[];
  shopHeading: string;
  shopLinks: string[];
  blogKicker: string;
  blogLink: string;
  copyright: string;
  privacy: string;
  terms: string;
}
const { lang, brand, description, badges, shopHeading, shopLinks, blogKicker, blogLink, copyright, privacy, terms } =
  Astro.props;
const year = new Date().getFullYear();
---

<footer class="relative border-t border-white/5 bg-[#241009] px-6 py-20 text-cream-soft/80">
  <div class="mx-auto max-w-7xl">
    <div class="mb-16 grid grid-cols-1 gap-16 md:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-8 lg:col-span-2">
        <h2 class="font-display text-3xl tracking-tight text-gold">{brand}</h2>
        <p class="max-w-md text-lg leading-relaxed opacity-70">{description}</p>
        <div class="flex flex-wrap gap-2 pt-2">
          {badges.map((b) => (
            <span class="rounded-full border border-white/10 px-3 py-1 text-[10px] font-bold tracking-[0.1em] text-cream-soft/40">{b}</span>
          ))}
        </div>
      </div>
      <div class="space-y-6">
        <h3 class="text-xs font-bold uppercase tracking-[0.3em] text-white">{shopHeading}</h3>
        <ul class="space-y-1.5">
          {shopLinks.map((link, i) => (
            <li>
              {i === 0 && (
                <a href={SHOPEE_URL} target="_blank" rel="noopener noreferrer" class="inline-block py-1.5 text-start text-lg font-medium transition-colors hover:text-gold">{link}</a>
              )}
              {i === 1 && (
                <a href={TIKTOK_SHOP_URL} target="_blank" rel="noopener noreferrer" class="inline-block py-1.5 text-start text-lg font-medium transition-colors hover:text-gold">{link}</a>
              )}
              {i > 1 && (
                <button class="inline-block py-1.5 text-start text-lg font-medium transition-colors hover:text-gold">{link}</button>
              )}
            </li>
          ))}
        </ul>
      </div>
      <div class="space-y-6">
        <h3 class="text-xs font-bold uppercase tracking-[0.3em] text-white">{blogKicker}</h3>
        <ul class="space-y-4">
          <li>
            <a href={`/${lang}/blog/`} class="inline-block py-1.5 text-start text-lg font-medium transition-colors hover:text-gold">{blogLink}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mb-12 flex items-center gap-4">
      <a href="#" aria-label="Facebook" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 text-cream-soft/60 transition-colors hover:border-gold/40 hover:text-gold">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14.2 8.6V6.9c0-.8.5-1 1-1h2.5V2.1L14.4 2c-3.7 0-4.6 2.2-4.6 4.6v2H7v4.2h2.8V22h4.4v-9.2h3.3l.5-4.2h-3.8Z"></path></svg>
      </a>
      <a href="#" aria-label="Instagram" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 text-cream-soft/60 transition-colors hover:border-gold/40 hover:text-gold">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
      </a>
      <a href="#" aria-label="TikTok" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 text-cream-soft/60 transition-colors hover:border-gold/40 hover:text-gold">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.4 2c.4 3.3 2.2 5.2 5.2 5.4v4a8.4 8.4 0 0 1-5.1-1.6v6.4c0 8.1-8.9 10.6-12.5 4.8-2.3-3.8-.9-10.4 6.5-10.7v4.2c-.5.1-1 .2-1.5.4-1.4.5-2.2 1.9-1.8 3.3.8 2.7 5.2 3.5 5.2-1.7V2h4Z"></path></svg>
      </a>
      <a href="#" aria-label="WhatsApp" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 text-cream-soft/60 transition-colors hover:border-gold/40 hover:text-gold">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.1 2A9.8 9.8 0 0 0 3.7 16.8L2.5 22l5.3-1.4A9.9 9.9 0 1 0 12.1 2Zm0 2a7.9 7.9 0 0 1 6.8 11.9 7.8 7.8 0 0 1-9.6 3l-.4-.2-3.1.8.8-3-.2-.5A7.8 7.8 0 0 1 12.1 4Zm-3 3.9c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.4 5.2 4.6 2.6 1 3.1.8 3.7.7.6-.1 1.8-.8 2.1-1.5.3-.7.3-1.3.2-1.5-.1-.1-.3-.2-.7-.4l-2.1-1c-.3-.1-.6-.2-.8.2l-.9 1.1c-.2.2-.4.3-.8.1a6.4 6.4 0 0 1-3.2-2.8c-.2-.4 0-.6.1-.8l.6-.7c.2-.2.2-.4.3-.6.1-.2 0-.4 0-.6l-1-2.3c-.2-.5-.5-.5-.8-.5H9.1Z"></path></svg>
      </a>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-8 text-[10px] uppercase tracking-[0.2em] opacity-40 md:flex-row">
      <p>© {year} {copyright}</p>
      <!-- py-2 clears the 24px WCAG 2.2 target minimum; at this 10px type the
           bare buttons were 15px tall. -->
      <div class="flex gap-8">
        <button class="py-2">{privacy}</button>
        <button class="py-2">{terms}</button>
      </div>
    </div>
  </div>
</footer>

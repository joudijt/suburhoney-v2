---
import { SITE_URL, SITE_NAME, BRAND_SELLER_URL, LOCALES, LOCALE_META, type Locale } from "../config/site";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  faqItems: { q: string; a: string }[];
}

const { lang, title, description, faqItems } = Astro.props;
const path = Astro.url.pathname.replace(/^\/(en|ar|ms)/, "") || "/";
const canonical = `${SITE_URL}/${lang}${path === "/" ? "" : path}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      name: SITE_NAME,
      url: SITE_URL,
      logo: `${SITE_URL}/logo-8.png`,
      sameAs: [BRAND_SELLER_URL],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: SITE_URL,
      name: SITE_NAME,
      publisher: { "@id": `${SITE_URL}/#organization` },
      inLanguage: lang,
    },
    {
      "@type": "Product",
      name: SITE_NAME,
      image: [`${SITE_URL}/jarncap.png`, `${SITE_URL}/jar.png`],
      description,
      brand: { "@type": "Brand", name: SITE_NAME },
      category: "Honey",
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "MYR",
        availability: "https://schema.org/InStock",
        url: canonical,
        seller: { "@id": `${SITE_URL}/#organization` },
      },
      aggregateRating: { "@type": "AggregateRating", ratingValue: "5", reviewCount: "5000" },
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: canonical }],
    },
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow, max-image-preview:large" />

{LOCALES.map((l) => (
  <link rel="alternate" hreflang={l} href={`${SITE_URL}/${l}${path === "/" ? "" : path}`} />
))}
<link rel="alternate" hreflang="x-default" href={`${SITE_URL}/en${path === "/" ? "" : path}`} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={`${SITE_URL}/jarncap.png`} />
<meta property="og:image:width" content="800" />
<meta property="og:image:height" content="1000" />
<meta property="og:locale" content={LOCALE_META[lang].ogLocale} />
{LOCALES.filter((l) => l !== lang).map((l) => (
  <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />
))}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${SITE_URL}/jarncap.png`} />

<link rel="shortcut icon" href="/favi.svg" />
<link rel="icon" href="/favi.svg" />
<link rel="apple-touch-icon" href="/favi.svg" />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

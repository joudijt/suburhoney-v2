---
import { SITE_URL, SITE_NAME, BRAND_SELLER_URL, INSTAGRAM_URL, FACEBOOK_URL, SHOPEE_URL, TIKTOK_SHOP_URL, LOCALES, LOCALE_META, localeUrl, type Locale } from "../config/site";
import { PRODUCT_ID, STORE_NODES } from "../config/schema";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  faqItems: { q: string; a: string }[];
  /**
   * Explicit per-locale URLs for hreflang.
   *
   * Needed because article slugs differ by language - /ms/blog/madu-suami-isteri
   * and /en/blog/honey-for-couples-malaysia are the same page. Deriving the
   * alternates from the current path, which is right everywhere else, would
   * point at URLs that do not exist.
   */
  alternates?: Partial<Record<Locale, string>>;
  /** Replaces the default @graph. Article pages describe themselves, not the product. */
  schemaGraph?: unknown[];
  /** Emits og:type=article plus the article timestamps. */
  articleMeta?: { published: string; updated: string; section?: string; tags?: string[] };
  /** Absolute URL of the social image, when it is not the default jar. */
  image?: string;
}

const {
  lang,
  title,
  description,
  faqItems,
  alternates,
  schemaGraph,
  articleMeta,
  image,
} = Astro.props;

const path = Astro.url.pathname.replace(/^\/(en|ar|ms)/, "") || "/";
const canonical = alternates?.[lang] ?? localeUrl(lang, path);
const hreflangFor = (l: Locale) => alternates?.[l] ?? localeUrl(l, path);
const socialImage = image ?? `${SITE_URL}/jarncap.png`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": schemaGraph ?? [
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      name: SITE_NAME,
      url: SITE_URL,
      logo: `${SITE_URL}/logo-8.webp`,
      sameAs: [BRAND_SELLER_URL, INSTAGRAM_URL, FACEBOOK_URL, SHOPEE_URL, TIKTOK_SHOP_URL],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: SITE_URL,
      name: SITE_NAME,
      publisher: { "@id": `${SITE_URL}/#organization` },
      inLanguage: lang,
    },
    ...STORE_NODES,
    /*
      No `offers`.

      It was an AggregateOffer carrying only priceCurrency and availability.
      An AggregateOffer must carry lowPrice, or price/priceSpecification, so
      Google rejected the offer and with it the whole Product node - the markup
      yielded nothing. No price was supplied and inventing one is a checkable
      falsehood (FORGE-SPEC D9), so the property is removed rather than filled
      in: an absent offer costs nothing, an invalid one costs the Product.

      The seller relationship it carried survives on the store side, as
      SELLER_NODE.hasOfferCatalog -> PRODUCT_ID, which needs no price.
    */
    {
      "@type": "Product",
      "@id": PRODUCT_ID,
      name: SITE_NAME,
      image: [`${SITE_URL}/jarncap.png`, `${SITE_URL}/jarncap.webp`],
      description,
      brand: { "@type": "Brand", name: SITE_NAME },
      category: "Honey",
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: canonical }],
    },
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow, max-image-preview:large" />

{LOCALES.map((l) => (
  <link rel="alternate" hreflang={l} href={hreflangFor(l)} />
))}
<link rel="alternate" hreflang="x-default" href={hreflangFor("en")} />

<meta property="og:type" content={articleMeta ? "article" : "website"} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
{!image && <meta property="og:image:width" content="400" />}
{!image && <meta property="og:image:height" content="639" />}
<meta property="og:locale" content={LOCALE_META[lang].ogLocale} />
{LOCALES.filter((l) => l !== lang).map((l) => (
  <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />
))}

{articleMeta && (
  <>
    <meta property="article:published_time" content={articleMeta.published} />
    <meta property="article:modified_time" content={articleMeta.updated} />
    {articleMeta.section && <meta property="article:section" content={articleMeta.section} />}
    {articleMeta.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<!--
  The sealed jar is the LCP element on the homepage (it's a static image now -
  the flying-ingredients animation moved to the Ritual section, which is
  below the fold and lazy-loaded there instead). Without a preload the
  browser only discovers it after the stylesheet parses, which cost ~500ms of
  LCP. Article/inner pages have no jar, so preloading there would just put a
  competing request on the critical path - see CLAUDE.md on why request count
  is expensive on this host.
-->
{!articleMeta && (
  <link rel="preload" as="image" href="/jarncap.webp" type="image/webp" fetchpriority="high" />
)}

<link rel="shortcut icon" href="/favi.svg" />
<link rel="icon" href="/favi.svg" />
<link rel="apple-touch-icon" href="/favi.svg" />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

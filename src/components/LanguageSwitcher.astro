---
import { LOCALES, LOCALE_META, type Locale } from "../config/site";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const path = Astro.url.pathname.replace(/^\/(en|ar|ms)/, "") || "";
---

<div class="lang-switcher relative" data-lang-switcher>
  <button
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label="Change language"
    class="flex h-10 w-10 items-center justify-center rounded-full border border-brown/15 text-brown/70 transition-colors hover:border-gold hover:text-gold"
    data-lang-toggle
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3c2.5 2.6 4 6 4 9s-1.5 6.4-4 9c-2.5-2.6-4-6-4-9s1.5-6.4 4-9Z"></path>
    </svg>
  </button>
  <ul
    class="pointer-events-none absolute end-0 z-50 mt-3 w-44 origin-top-right scale-95 rounded-2xl border border-brown/10 bg-cream-soft py-2 opacity-0 shadow-soft transition-all duration-200"
    data-lang-menu
  >
    {LOCALES.map((code) => (
      <li>
        <a
          href={`/${code}${path}`}
          class:list={[
            "block px-5 py-2.5 text-sm transition-colors hover:bg-sand/60",
            code === lang ? "font-semibold text-gold" : "text-brown/80",
          ]}
        >
          {LOCALE_META[code].label}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-lang-switcher]").forEach((wrap) => {
    const toggle = wrap.querySelector<HTMLButtonElement>("[data-lang-toggle]");
    const menu = wrap.querySelector<HTMLUListElement>("[data-lang-menu]");
    if (!toggle || !menu) return;

    const close = () => {
      menu.classList.add("opacity-0", "scale-95", "pointer-events-none");
      toggle.setAttribute("aria-expanded", "false");
    };
    const open = () => {
      menu.classList.remove("opacity-0", "scale-95", "pointer-events-none");
      toggle.setAttribute("aria-expanded", "true");
    };

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      isOpen ? close() : open();
    });
    document.addEventListener("click", close);
  });
</script>

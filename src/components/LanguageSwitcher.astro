---
import { LOCALES, LOCALE_META, type Locale } from "../config/site";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const path = Astro.url.pathname.replace(/^\/(en|ar|ms)/, "") || "";
---

<div class="lang-switcher relative" data-lang-switcher>
  <button
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label="Change language"
    class="flex h-10 items-center gap-2 rounded-full border border-brown/15 px-4 text-sm font-medium text-brown/70 transition-colors hover:border-gold hover:text-gold"
    data-lang-toggle
  >
    <span>{LOCALE_META[lang].label}</span>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="transition-transform duration-200" data-lang-chevron aria-hidden="true">
      <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <ul
    class="pointer-events-none absolute end-0 z-50 mt-3 w-44 origin-top-right scale-95 rounded-2xl border border-brown/10 bg-cream-soft py-2 opacity-0 shadow-soft transition-all duration-200"
    data-lang-menu
  >
    {LOCALES.map((code) => (
      <li>
        <a
          href={`/${code}${path}`}
          class:list={[
            "block px-5 py-2.5 text-sm transition-colors hover:bg-sand/60",
            code === lang ? "font-semibold text-gold" : "text-brown/80",
          ]}
        >
          {LOCALE_META[code].label}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-lang-switcher]").forEach((wrap) => {
    const toggle = wrap.querySelector<HTMLButtonElement>("[data-lang-toggle]");
    const menu = wrap.querySelector<HTMLUListElement>("[data-lang-menu]");
    const chevron = wrap.querySelector<SVGElement>("[data-lang-chevron]");
    if (!toggle || !menu) return;

    const close = () => {
      menu.classList.add("opacity-0", "scale-95", "pointer-events-none");
      toggle.setAttribute("aria-expanded", "false");
      chevron?.classList.remove("rotate-180");
    };
    const open = () => {
      menu.classList.remove("opacity-0", "scale-95", "pointer-events-none");
      toggle.setAttribute("aria-expanded", "true");
      chevron?.classList.add("rotate-180");
    };

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      isOpen ? close() : open();
    });
    document.addEventListener("click", close);
  });
</script>

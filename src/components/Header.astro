---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { LOCALE_META, type Locale } from "../config/site";

import en from "../i18n/locales/en/common.json";
import ar from "../i18n/locales/ar/common.json";
import ms from "../i18n/locales/ms/common.json";

const content = { en, ar, ms } as const;

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = content[lang].nav;
const dir = LOCALE_META[lang].dir;

const links = [
  { href: `/${lang}`, label: t.home },
  { href: `/${lang}/benefits/`, label: t.benefits },
  { href: `/${lang}/retail/`, label: t.retail },
  { href: `/${lang}/why-us/`, label: t.whyUs },
  { href: `/${lang}/contact/`, label: t.contact },
];

/* Computed per-page at build time - Astro.url.pathname is this page's own
   path in a statically generated site, so this is safe and correct. */
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === (href.replace(/\/$/, "") || "/");
---

<header
  class="sticky top-0 z-50 border-b border-brown/[0.06] bg-cream-soft/70 backdrop-blur-md"
>
  <!-- dir="ltr" is deliberate: the logo must always sit physically at the
       left edge and the language switcher at the right, in every language,
       instead of swapping sides under Arabic's natural RTL flex reversal.
       The nav in between re-declares its own dir so Arabic links still read
       right-to-left within that middle segment. -->
  <div dir="ltr" class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6 md:px-10">
    <a href={`/${lang}`} class="flex items-center gap-2">
      <img src="/logo-8.webp" alt="Subur Logo" width="140" height="47" class="h-9 w-auto object-contain md:h-10" />
    </a>

    <nav dir={dir} aria-label="Primary" class="hidden items-center gap-8 md:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "text-sm font-medium transition-colors hover:text-gold",
            isActive(link.href) ? "text-gold" : "text-brown/70",
          ]}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <LanguageSwitcher lang={lang} />
      <button
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label={t.menu}
        class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full border border-brown/15 text-brown/70 transition-colors hover:border-gold hover:text-gold md:hidden"
        data-mobile-menu-toggle
      >
        <svg data-menu-icon-open width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
        <svg data-menu-icon-close width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" class="hidden" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    aria-label={t.menu}
    class="pointer-events-none grid grid-rows-[0fr] border-b border-brown/[0.06] bg-cream-soft/95 backdrop-blur-md transition-[grid-template-rows] duration-300 md:hidden"
    data-mobile-menu
  >
    <div class="overflow-hidden">
      <ul class="flex flex-col gap-1 px-6 py-4">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "block rounded-xl px-4 py-3 text-base font-medium transition-colors",
                isActive(link.href) ? "bg-gold/10 text-gold" : "text-brown/80 hover:bg-sand/50",
              ]}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<script>
  document.querySelectorAll<HTMLElement>("[data-mobile-menu-toggle]").forEach((toggle) => {
    const menu = toggle.closest("header")?.querySelector<HTMLElement>("[data-mobile-menu]");
    const iconOpen = toggle.querySelector<SVGElement>("[data-menu-icon-open]");
    const iconClose = toggle.querySelector<SVGElement>("[data-menu-icon-close]");
    if (!menu) return;

    const close = () => {
      menu.classList.remove("pointer-events-auto");
      menu.classList.add("pointer-events-none");
      menu.style.gridTemplateRows = "0fr";
      toggle.setAttribute("aria-expanded", "false");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    };
    const open = () => {
      menu.classList.add("pointer-events-auto");
      menu.classList.remove("pointer-events-none");
      menu.style.gridTemplateRows = "1fr";
      toggle.setAttribute("aria-expanded", "true");
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
    };

    toggle.addEventListener("click", () => {
      toggle.getAttribute("aria-expanded") === "true" ? close() : open();
    });
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  });
</script>

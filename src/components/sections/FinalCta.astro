---
import type { Locale } from "../../config/site";
interface Props {
  lang: Locale;
  heading: string;
  subheading: string;
  ctaPrimary: string;
  ctaSecondary: string;
  ratingText: string;
}
const { lang, heading, subheading, ctaPrimary, ctaSecondary, ratingText } = Astro.props;
---

<section class="relative border-t border-brown/5 bg-cream px-6 py-28 text-center md:py-36" data-reveal-group>
  <div class="mx-auto max-w-3xl space-y-10">
    <h2 class="font-display text-5xl leading-[1.1] text-brown md:text-7xl" data-reveal>{heading}</h2>
    <p class="text-xl leading-relaxed text-brown/70" data-reveal>{subheading}</p>
    <div class="flex flex-col justify-center gap-5 pt-4 sm:flex-row" data-reveal>
      <button type="button" data-store-modal-trigger class="btn-primary">{ctaPrimary}</button>
      <a href={`/${lang}/#wholesale`} class="btn-secondary">{ctaSecondary}</a>
    </div>
    {/*
      No star row here. Five filled stars above this line read as a 5.0 score, and
      nothing on this site collects reviews - the same unsubstantiated claim that had
      to come out of the Product schema (aggregateRating 5/5000). The stars survived
      that cleanup only because they were decorative markup rather than text, so every
      grep for the number passed while a visitor still saw the rating.
      Do not reintroduce them unless a real review source exists to back them.
    */}
    <div class="flex flex-col items-center gap-2 pt-6" data-reveal>
      <p class="text-sm font-bold uppercase tracking-widest text-brown/55">{ratingText}</p>
    </div>
  </div>
</section>

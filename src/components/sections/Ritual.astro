---
interface Props {
  heading: string;
  subheading: string;
  steps: string[];
}
const { heading, subheading, steps } = Astro.props;
---

<section id="ritual" class="relative overflow-hidden px-6 py-28 md:py-36" data-reveal-group>
  <div class="absolute inset-x-0 bottom-0 -z-20 h-[130%]" data-parallax="0.06">
    <img
      src="/images/ritual-showcase.jpg"
      alt=""
      aria-hidden="true"
      loading="lazy"
      class="h-full w-full object-cover object-bottom"
    />
  </div>
  <div class="mx-auto max-w-7xl">
    <div class="max-w-xl space-y-12 rounded-[2rem] bg-cream-soft/55 p-8 backdrop-blur-xl md:p-12" data-reveal>
      <div class="space-y-5">
        <p class="kicker">A Simple Daily Habit</p>
        <h2 class="font-display text-4xl text-brown md:text-5xl lg:text-6xl">{heading}</h2>
        <p class="max-w-xl text-lg leading-relaxed text-brown/70">{subheading}</p>
      </div>
      <div id="ritual-steps" class="space-y-7">
        {steps.map((step, i) => (
          <div class="ritual-step relative flex items-center gap-5">
            <div class="relative z-10 flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full border border-gold/50 bg-cream-soft/80 font-display text-base text-honey-dark backdrop-blur-sm">
              {i + 1}
            </div>
            {i < steps.length - 1 && (
              <span class="ritual-line absolute left-[21px] top-11 h-7 w-0.5 origin-top scale-y-0 bg-gold/50"></span>
            )}
            <p class="ritual-text font-display text-lg italic text-brown opacity-0 md:text-xl">{step}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { initRitual } from "../../scripts/ritual-motion";
  initRitual();
</script>

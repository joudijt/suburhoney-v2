---
interface Props {
  heading: string;
  subheading: string;
  steps: string[];
}
const { heading, subheading, steps } = Astro.props;
---

<section id="ritual" class="relative overflow-hidden px-6 py-28 md:py-36" data-reveal-group>
  <div class="absolute inset-0 -z-20" data-parallax="0.06">
    <img
      src="/images/ritual-showcase.jpg"
      alt=""
      aria-hidden="true"
      loading="lazy"
      class="h-[130%] w-full object-cover object-center"
    />
  </div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-cream via-cream/85 to-cream/25 rtl:bg-gradient-to-l"></div>

  <div class="mx-auto max-w-7xl">
    <div class="max-w-xl space-y-12" data-reveal>
      <div class="space-y-5">
        <p class="kicker">A Simple Daily Habit</p>
        <h2 class="font-display text-4xl text-brown md:text-5xl lg:text-6xl">{heading}</h2>
        <p class="max-w-xl text-lg leading-relaxed text-brown/70">{subheading}</p>
      </div>
      <div class="space-y-7">
        {steps.map((step, i) => (
          <div class="flex items-center gap-5">
            <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full border border-gold/50 bg-cream-soft/80 font-display text-base text-honey-dark backdrop-blur-sm">
              {i + 1}
            </div>
            <p class="font-display text-lg italic text-brown md:text-xl">{step}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

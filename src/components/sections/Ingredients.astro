---
interface Item {
  name: string;
  alt: string;
  description: string;
  icon: string;
}
interface FooterNote {
  before: string;
  wholesaleLink: string;
  middle: string;
  madinahLink: string;
  after: string;
  faqLink: string;
  end: string;
}
interface Props {
  heading: string;
  subheading: string;
  items: Item[];
  footerNote: FooterNote;
}
const { heading, subheading, items, footerNote } = Astro.props;

// Pointy-top hexagon honeycomb, 3-4-3 interlocking rows (10 cells).
const positions = [
  { left: 12.5, top: 0 },
  { left: 37.5, top: 0 },
  { left: 62.5, top: 0 },
  { left: 0, top: 30 },
  { left: 25, top: 30 },
  { left: 50, top: 30 },
  { left: 75, top: 30 },
  { left: 12.5, top: 60 },
  { left: 37.5, top: 60 },
  { left: 62.5, top: 60 },
];
---

<section id="ingredients" class="relative overflow-hidden bg-cream-soft px-6 py-28 md:py-36" data-reveal-group>
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto mb-16 max-w-2xl space-y-5 text-center" data-reveal>
      <p class="kicker">Ten Ingredients, One Recipe</p>
      <h2 id="ingredients-heading" class="font-display text-3xl text-brown md:text-5xl">{heading}</h2>
      <p class="text-lg text-brown/70">{subheading}</p>
    </div>

    <div class="honeycomb-stage relative mx-auto max-w-[640px] py-10" data-reveal>
      <!-- ambient background texture -->
      <div class="honeycomb-texture pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

      <!-- decorative droplets -->
      <div class="pointer-events-none absolute inset-0 -z-0" aria-hidden="true">
        <span class="hc-droplet absolute" style="left:4%; top:12%;"></span>
        <span class="hc-droplet absolute" style="left:92%; top:70%;"></span>
        <span class="hc-droplet absolute" style="left:8%; top:78%;"></span>
      </div>

      <div id="honeycomb" class="honeycomb relative mx-auto w-full" style="aspect-ratio: 1.386;">
        {items.map((item, i) => (
          <button
            type="button"
            class="hex-cell absolute"
            style={`left:${positions[i].left}%; top:${positions[i].top}%; width:25%; height:40%;`}
            data-index={i}
            data-name={item.name}
            data-description={item.description}
            data-icon={item.icon}
            data-alt={item.alt}
            aria-haspopup="dialog"
          >
            <span class="hex-shape">
              <span class="hex-shimmer" aria-hidden="true"></span>
              <img src={item.icon} alt={item.alt} loading="lazy" class="hex-icon" />
              <span class="hex-name">{item.name}</span>
            </span>
          </button>
        ))}
      </div>
    </div>

    <p class="mx-auto mt-16 max-w-2xl text-center text-sm text-brown/70" data-reveal>
      {footerNote.before}
      {" "}<a href="#wholesale" class="font-semibold text-honey-dark underline underline-offset-4 hover:text-gold">{footerNote.wholesaleLink}</a>{footerNote.middle}
      {" "}<a href="https://madinah.com.my/en/" target="_blank" rel="noopener noreferrer" class="font-semibold text-honey-dark underline underline-offset-4 hover:text-gold">{footerNote.madinahLink}</a>{footerNote.after}
      {" "}<a href="#faq" class="font-semibold text-honey-dark underline underline-offset-4 hover:text-gold">{footerNote.faqLink}</a>{footerNote.end}
    </p>
  </div>

  <!-- ingredient detail panel -->
  <div id="ingredient-panel" class="ingredient-panel fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-labelledby="panel-name">
    <div class="ingredient-panel-backdrop absolute inset-0 bg-brown/40 backdrop-blur-sm opacity-0" data-close></div>
    <div class="ingredient-panel-card absolute inset-x-4 bottom-4 mx-auto max-w-md translate-y-6 rounded-[2rem] border border-white/40 bg-cream-soft/90 p-8 opacity-0 shadow-soft backdrop-blur-xl sm:inset-x-auto sm:end-8 sm:top-1/2 sm:bottom-auto sm:-translate-y-1/2 sm:translate-y-0">
      <button type="button" class="absolute end-6 top-6 flex h-9 w-9 items-center justify-center rounded-full border border-brown/15 text-brown/60 transition-colors hover:border-gold hover:text-gold" data-close aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <img id="panel-image" src="" alt="" class="mx-auto mb-6 h-28 w-28 object-contain drop-shadow-lg" />
      <h3 id="panel-name" class="mb-3 text-center font-display text-2xl text-brown"></h3>
      <p id="panel-desc" class="text-center leading-relaxed text-brown/75"></p>
    </div>
  </div>
</section>

<script>
  import { initHoneycomb } from "../../scripts/honeycomb-motion";
  initHoneycomb();
</script>

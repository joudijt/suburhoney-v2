---
import type { Locale } from "../../config/site";

interface Props {
  lang: Locale;
  heading: string;
  headingAccent: string;
  description: string;
  badges: string[];
  ctaPrimary: string;
  ctaSecondary: string;
}

const { heading, headingAccent, description, badges, ctaPrimary, ctaSecondary } = Astro.props;
---

<section id="hero" class="relative flex min-h-[100svh] w-full items-center overflow-hidden bg-cream pt-20">
  <!-- ambient background -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="hero-glow absolute left-1/2 top-1/2 h-[70vmax] w-[70vmax] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(230,168,38,0.22),transparent_65%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,253,248,0.6),transparent_55%)]"></div>
    {Array.from({ length: 14 }).map((_, i) => (
      <span class={`dust dust-${i % 7} absolute rounded-full bg-gold/70`} style={`--i:${i}`}></span>
    ))}
  </div>

  <div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-14 px-6 md:grid-cols-2 md:px-10">
    <!-- text column -->
    <div class="hero-text order-2 text-center md:order-1 md:text-start">
      <h1 class="font-display text-[2.4rem] leading-[1.15] text-brown md:text-6xl lg:text-[4.2rem]">
        <span class="hero-line block">{heading}</span>
        <span class="hero-line-accent block text-gold">{headingAccent}</span>
      </h1>
      <p class="hero-desc mx-auto mt-6 max-w-md text-base leading-relaxed text-brown/75 md:mx-0 md:text-lg">
        {description}
      </p>
      <div class="hero-badges mt-8 flex flex-wrap justify-center gap-2 md:justify-start">
        {badges.map((b) => (
          <span class="rounded-full border border-brown/15 bg-cream-soft px-4 py-1.5 text-[10px] font-semibold tracking-[0.18em] text-brown/70">
            {b}
          </span>
        ))}
      </div>
      <div class="hero-cta mt-10 flex flex-col justify-center gap-4 sm:flex-row md:justify-start">
        <button class="btn-primary">{ctaPrimary}</button>
        <button class="btn-secondary">{ctaSecondary}</button>
      </div>
    </div>

    <!-- jar stage -->
    <div class="order-1 md:order-2">
      <div id="hero-jar-wrapper" class="jar-stage relative mx-auto aspect-square w-[78%] max-w-[420px] md:w-full">
        <!-- honey stream + ripples, centered on jar -->
        <div class="honey-stream absolute left-1/2 top-0 h-full w-[7px] -translate-x-1/2 rounded-full bg-gradient-to-b from-gold via-honey-dark to-transparent opacity-0 blur-[0.5px]"></div>
        <span class="ripple absolute left-1/2 top-1/2 h-16 w-16 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-gold/60 opacity-0"></span>
        <span class="ripple absolute left-1/2 top-1/2 h-16 w-16 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-gold/50 opacity-0"></span>
        <span class="ripple absolute left-1/2 top-1/2 h-16 w-16 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-gold/40 opacity-0"></span>

        <!-- floating botanicals -->
        <img src="/icons/ingrediant_02.png" alt="" aria-hidden="true" class="botanical absolute left-[6%] top-[18%] h-12 w-12 opacity-0 md:h-16 md:w-16" />
        <img src="/icons/ingrediant_01.png" alt="" aria-hidden="true" class="botanical absolute right-[4%] top-[62%] h-10 w-10 opacity-0 md:h-14 md:w-14" />

        <!-- bees -->
        <svg class="bee absolute left-[12%] top-[40%] h-6 w-6 opacity-0" viewBox="0 0 24 24" aria-hidden="true">
          <ellipse cx="12" cy="12" rx="6" ry="4.5" fill="#402515" />
          <rect x="8" y="8.2" width="8" height="1.6" rx="0.8" fill="#E6A826" />
          <rect x="8" y="11.2" width="8" height="1.6" rx="0.8" fill="#E6A826" />
          <rect x="8" y="14.2" width="8" height="1.6" rx="0.8" fill="#E6A826" />
          <ellipse cx="4.5" cy="9" rx="3.2" ry="2.4" fill="white" opacity="0.55" />
          <ellipse cx="6" cy="6.5" rx="2.6" ry="2" fill="white" opacity="0.5" />
        </svg>
        <svg class="bee absolute right-[10%] top-[22%] h-5 w-5 opacity-0" viewBox="0 0 24 24" aria-hidden="true">
          <ellipse cx="12" cy="12" rx="6" ry="4.5" fill="#402515" />
          <rect x="8" y="8.2" width="8" height="1.6" rx="0.8" fill="#E6A826" />
          <rect x="8" y="11.2" width="8" height="1.6" rx="0.8" fill="#E6A826" />
          <rect x="8" y="14.2" width="8" height="1.6" rx="0.8" fill="#E6A826" />
          <ellipse cx="4.5" cy="9" rx="3.2" ry="2.4" fill="white" opacity="0.55" />
          <ellipse cx="6" cy="6.5" rx="2.6" ry="2" fill="white" opacity="0.5" />
        </svg>

        <!-- dipper (first-scroll story) -->
        <img
          id="dipper"
          src="/images/dipper.png"
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute left-[58%] top-[-55%] z-30 h-44 w-auto -translate-x-1/2 opacity-0 drop-shadow-xl md:h-60"
        />
        <div id="dipper-drips" class="pointer-events-none absolute inset-0 z-30"></div>

        <!-- jar -->
        <div class="jar-tilt absolute inset-0 flex items-center justify-center" style="transform-style: preserve-3d;">
          <img
            src="/jarncap.png"
            alt="Subur Honey, fully sealed jar"
            width="800"
            height="1000"
            class="hero-jar h-auto w-[64%] object-contain opacity-0 drop-shadow-2xl md:w-[58%]"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="scroll-cue pointer-events-none absolute bottom-8 left-1/2 -translate-x-1/2 opacity-0" aria-hidden="true">
    <span class="block h-9 w-5 rounded-full border border-brown/30">
      <span class="mx-auto mt-1.5 block h-1.5 w-1.5 animate-bounce rounded-full bg-gold"></span>
    </span>
  </div>
</section>

<script>
  import { initHero } from "../../scripts/hero-motion";
  initHero();
</script>

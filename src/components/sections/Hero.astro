---
import type { Locale } from "../../config/site";

interface Props {
  lang: Locale;
  heading: string;
  headingAccent: string;
  description: string;
  badges: string[];
  ctaPrimary: string;
  ctaSecondary: string;
}

const { heading, headingAccent, description, badges, ctaPrimary, ctaSecondary } = Astro.props;
---

<section id="hero" class="relative flex min-h-[100svh] w-full items-center overflow-hidden bg-cream pt-20">
  <!-- ambient background -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="hero-glow absolute left-1/2 top-1/2 h-[70vmax] w-[70vmax] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(230,168,38,0.22),transparent_65%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,253,248,0.6),transparent_55%)]"></div>
  </div>

  <div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-14 px-6 md:px-10 lg:grid-cols-2">
    <!-- text column -->
    <div class="hero-text order-2 text-center lg:order-1 lg:text-start">
      <h1 class="font-display text-[2.4rem] leading-[1.15] text-brown md:text-6xl lg:text-[4.2rem]">
        <span class="hero-line block">{heading}</span>
        <span class="hero-line-accent block text-gold">{headingAccent}</span>
      </h1>
      <p class="hero-desc mx-auto mt-6 max-w-md text-base leading-relaxed text-brown/75 md:mx-0 md:text-lg">
        {description}
      </p>
      <div class="hero-badges mt-8 flex flex-wrap justify-center gap-2 lg:justify-start">
        {badges.map((b) => (
          <span class="rounded-full border border-brown/15 bg-cream-soft px-4 py-1.5 text-[10px] font-semibold tracking-[0.18em] text-brown/70">
            {b}
          </span>
        ))}
      </div>
      <div class="hero-cta mt-10 flex flex-col justify-center gap-4 sm:flex-row lg:justify-start">
        <button class="btn-primary">{ctaPrimary}</button>
        <button class="btn-secondary">{ctaSecondary}</button>
      </div>
    </div>

    <!-- jar stage -->
    <div class="order-1 lg:order-2">
      <div id="hero-jar-wrapper" class="jar-stage relative mx-auto aspect-square w-[78%] max-w-[420px] sm:max-w-[460px] lg:w-full">
        <!-- jar -->
        <div class="jar-tilt absolute inset-0 flex items-center justify-center">
          <img
            src="/images/hero-jar-sealed.png"
            alt="Subur Honey, fully sealed jar"
            class="hero-jar h-auto w-[62%] object-contain opacity-0 drop-shadow-2xl md:w-[56%]"
          />
        </div>

        <!-- ingredients: float around the base of the jar -->
        <img src="/icons/ingrediant_04.png" alt="" aria-hidden="true" class="ingredient absolute left-[0%] top-[66%] h-12 w-12 opacity-0 md:h-16 md:w-16" />
        <img src="/icons/ingrediant_01.png" alt="" aria-hidden="true" class="ingredient absolute left-[16%] top-[87%] h-10 w-10 opacity-0 md:h-14 md:w-14" />
        <img src="/icons/ingrediant_08.png" alt="" aria-hidden="true" class="ingredient absolute right-[-2%] top-[72%] h-14 w-14 opacity-0 md:h-20 md:w-20" />
        <img src="/icons/ingrediant_06.png" alt="" aria-hidden="true" class="ingredient absolute right-[16%] top-[92%] h-11 w-11 opacity-0 md:h-16 md:w-16" />
        <img src="/icons/ingrediant_09.png" alt="" aria-hidden="true" class="ingredient absolute left-[36%] top-[95%] h-9 w-9 opacity-0 md:h-12 md:w-12" />
        <img src="/icons/ingrediant_02.png" alt="" aria-hidden="true" class="ingredient absolute right-[34%] top-[94%] h-11 w-11 opacity-0 md:h-16 md:w-16" />
      </div>
    </div>
  </div>

  <div class="scroll-cue pointer-events-none absolute bottom-8 left-1/2 -translate-x-1/2 opacity-0" aria-hidden="true">
    <span class="block h-9 w-5 rounded-full border border-brown/30">
      <span class="mx-auto mt-1.5 block h-1.5 w-1.5 animate-bounce rounded-full bg-gold"></span>
    </span>
  </div>
</section>

<script>
  import { initHero } from "../../scripts/hero-motion";
  initHero();
</script>

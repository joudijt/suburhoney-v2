---
import type { Locale } from "../../config/site";

interface Props {
  lang: Locale;
  heading: string;
  headingAccent: string;
  description: string;
  badges: string[];
  ctaPrimary: string;
  ctaSecondary: string;
}

const { heading, headingAccent, description, badges, ctaPrimary, ctaSecondary } = Astro.props;
---

<section id="hero" class="relative flex min-h-[100svh] w-full items-center overflow-hidden bg-cream pt-20">
  <!-- ambient background -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="hero-glow absolute left-1/2 top-1/2 h-[70vmax] w-[70vmax] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(230,168,38,0.22),transparent_65%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,253,248,0.6),transparent_55%)]"></div>
  </div>

  <div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-14 px-6 md:px-10 lg:grid-cols-2">
    <!-- text column -->
    <div class="hero-text order-2 text-center lg:order-1 lg:text-start">
      <h1 class="font-display text-[2.4rem] leading-[1.15] text-brown md:text-6xl lg:text-[4.2rem]">
        <span class="hero-line block">{heading}</span>
        <span class="hero-line-accent block text-gold">{headingAccent}</span>
      </h1>
      <p class="hero-desc mx-auto mt-6 max-w-md text-base leading-relaxed text-brown/75 md:mx-0 md:text-lg">
        {description}
      </p>
      <div class="hero-badges mt-8 flex flex-wrap justify-center gap-2 lg:justify-start">
        {badges.map((b) => (
          <span class="rounded-full border border-brown/15 bg-cream-soft px-4 py-1.5 text-[10px] font-semibold tracking-[0.18em] text-brown/70">
            {b}
          </span>
        ))}
      </div>
      <div class="hero-cta mt-10 flex flex-col justify-center gap-4 sm:flex-row lg:justify-start">
        <button type="button" data-store-modal-trigger class="btn-primary">{ctaPrimary}</button>
        <button class="btn-secondary">{ctaSecondary}</button>
      </div>
    </div>

    <!-- jar stage -->
    <div class="order-1 lg:order-2">
      <div id="hero-jar-wrapper" class="jar-stage relative mx-auto aspect-square w-[78%] max-w-[420px] sm:max-w-[460px] lg:w-full">
        <!-- invisible target the flying ingredients converge on -->
        <span id="jar-mouth" class="pointer-events-none absolute left-1/2 top-[16%] h-px w-px" aria-hidden="true"></span>

        <!-- jar: open jar underneath, sealed jar crossfades in once ingredients land -->
        <div class="jar-tilt absolute inset-0 flex items-center justify-center" style="transform-style: preserve-3d;">
          <img
            src="/jar.webp"
            alt=""
            aria-hidden="true"
            width="400"
            height="639"
            fetchpriority="high"
            decoding="async"
            class="hero-jar-open absolute h-auto w-[64%] object-contain drop-shadow-2xl md:w-[58%]"
          />
          <img
            data-src="/jarncap.webp"
            alt="Subur Honey, fully sealed jar"
            width="400"
            height="639"
            fetchpriority="high"
            decoding="async"
            class="hero-jar-sealed absolute h-auto w-[64%] object-contain opacity-0 drop-shadow-2xl md:w-[58%]"
          />
        </div>

        <!-- ingredients: start in a ring above the open jar, then fly down into its mouth -->
        <img data-src="/icons/ingrediant_05.webp" alt="" aria-hidden="true" width="224" height="224" decoding="async" class="ingredient absolute h-14 w-14 opacity-0 md:h-20 md:w-20" style="top:-6%; left:18%;" />
        <img data-src="/icons/ingrediant_07.webp" alt="" aria-hidden="true" width="224" height="224" decoding="async" class="ingredient absolute h-14 w-14 opacity-0 md:h-20 md:w-20" style="top:2%; left:42%;" />
        <img data-src="/icons/ingrediant_03.webp" alt="" aria-hidden="true" width="224" height="224" decoding="async" class="ingredient absolute h-14 w-14 opacity-0 md:h-20 md:w-20" style="top:-4%; left:64%;" />
        <img data-src="/icons/ingrediant_01.webp" alt="" aria-hidden="true" width="224" height="224" decoding="async" class="ingredient absolute h-14 w-14 opacity-0 md:h-20 md:w-20" style="top:6%; left:82%;" />
        <img data-src="/icons/ingrediant_10.webp" alt="" aria-hidden="true" width="224" height="224" decoding="async" class="ingredient absolute h-12 w-12 opacity-0 md:h-16 md:w-16" style="top:20%; left:92%;" />
        <img data-src="/icons/ingrediant_08.webp" alt="" aria-hidden="true" width="224" height="224" decoding="async" class="ingredient absolute h-12 w-12 opacity-0 md:h-16 md:w-16" style="top:34%; left:86%;" />
        <img data-src="/icons/ingrediant_09.webp" alt="" aria-hidden="true" width="224" height="224" decoding="async" class="ingredient absolute h-12 w-12 opacity-0 md:h-16 md:w-16" style="top:38%; left:66%;" />
        <img data-src="/icons/ingrediant_06.webp" alt="" aria-hidden="true" width="224" height="224" decoding="async" class="ingredient absolute h-12 w-12 opacity-0 md:h-16 md:w-16" style="top:36%; left:38%;" />
        <img data-src="/icons/ingrediant_04.webp" alt="" aria-hidden="true" width="224" height="224" decoding="async" class="ingredient absolute h-12 w-12 opacity-0 md:h-16 md:w-16" style="top:32%; left:16%;" />
        <img data-src="/icons/ingrediant_02.webp" alt="" aria-hidden="true" width="224" height="224" decoding="async" class="ingredient absolute h-12 w-12 opacity-0 md:h-16 md:w-16" style="top:18%; left:4%;" />
      </div>
    </div>
  </div>
</section>

<script>
  import { initHero } from "../../scripts/hero-motion";
  initHero();
</script>

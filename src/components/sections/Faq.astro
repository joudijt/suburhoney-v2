---
interface Item {
  q: string;
  a: string;
}
interface Props {
  heading: string;
  items: Item[];
}
const { heading, items } = Astro.props;
---

<section id="faq" class="relative bg-cream-soft px-6 py-20 md:py-28" data-reveal-group>
  <div class="mx-auto max-w-3xl">
    <h2 class="mb-14 text-center font-display text-4xl italic text-brown md:text-5xl" data-reveal>{heading}</h2>
    <div class="divide-y divide-brown/10">
      {items.map((item) => (
        <details data-reveal class="faq-item group py-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-8">
            <span class="font-display text-lg text-brown transition-colors group-hover:text-honey-dark md:text-2xl">{item.q}</span>
            <span class="faq-icon flex-shrink-0 text-2xl text-gold transition-transform duration-300 group-open:rotate-45">+</span>
          </summary>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-brown/70 md:text-lg">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>

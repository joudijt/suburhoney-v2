---
import type { Block } from "../../content/articles/types";

interface Props {
  blocks: Block[];
  ctaHref: string;
}

const { blocks, ctaHref } = Astro.props;

const calloutTone = {
  note: { border: "border-gold/35", bg: "bg-gold/[0.07]", dot: "bg-gold" },
  warning: { border: "border-honey-dark/35", bg: "bg-honey-dark/[0.06]", dot: "bg-honey-dark" },
  origin: { border: "border-brown/20", bg: "bg-brown/[0.04]", dot: "bg-brown/60" },
} as const;
---

{blocks.map((block) => {
  switch (block.type) {
    /* The answer box. First thing a reader sees, and the passage an answer
       engine is most likely to quote, so it carries the real answer. */
    case "answer":
      return (
        <div
          data-reveal
          class="not-prose relative my-10 rounded-[1.75rem] border border-gold/30 bg-[linear-gradient(150deg,rgba(230,168,38,0.12),rgba(255,253,248,0.5))] p-6 shadow-softer sm:p-8"
        >
          {/* The honey-jar sticker that used to hang off the top corner here was
              removed at the user's request, site-wide. The question no longer
              needs `max-w-[80%]` either - that only existed to keep the text
              clear of the sticker.
              The question is a display-face heading rather than the old 10px
              uppercase label, so it outranks the answer under it - matching the
              treatment on the benefits lead image. Uppercase + wide tracking
              also did nothing for the Arabic locale. */}
          <p class="mb-3 font-display text-2xl leading-snug text-brown sm:text-3xl">
            {block.question}
          </p>
          <p class="text-lg leading-relaxed text-brown/85 sm:text-xl">{block.answer}</p>
        </div>
      );

    case "heading":
      return (
        <h2
          id={block.id}
          data-reveal
          data-toc-heading
          class="mt-14 scroll-mt-28 font-display text-2xl leading-snug text-brown sm:text-3xl md:mt-16 md:text-4xl"
        >
          {block.text}
        </h2>
      );

    /* text may carry inline <strong> / <a> - authored in the content files
       below, never from user input, so set:html is safe here. */
    case "paragraph":
      return (
        <p
          data-reveal
          class="mt-5 text-[1.0625rem] leading-[1.75] text-brown/80 sm:text-lg sm:leading-[1.8] [&_a]:font-semibold [&_a]:text-honey-dark [&_a]:underline [&_a]:decoration-gold/50 [&_a]:underline-offset-2 [&_a:hover]:decoration-honey-dark [&_strong]:font-semibold [&_strong]:text-brown"
          set:html={block.text}
        />
      );

    case "list":
      return (
        <div data-reveal class="not-prose mt-8">
          {block.title && (
            <p class="mb-4 font-display text-lg text-brown sm:text-xl">{block.title}</p>
          )}
          <ul class="space-y-3">
            {block.items.map((item, i) => (
              <li class="flex gap-4 rounded-2xl border border-brown/10 bg-cream-soft/60 p-4 sm:p-5">
                <span
                  class="mt-0.5 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-gold/15 text-xs font-bold text-honey-dark"
                  aria-hidden="true"
                >
                  {block.ordered ? (
                    i + 1
                  ) : (
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  )}
                </span>
                <span class="text-[1.0625rem] leading-[1.7] text-brown/80 [&_a]:font-semibold [&_a]:text-honey-dark [&_a]:underline [&_a]:decoration-gold/50 [&_a]:underline-offset-2 [&_a:hover]:decoration-honey-dark [&_strong]:font-semibold [&_strong]:text-brown">
                  {item.term && <strong class="font-semibold text-brown">{item.term}. </strong>}
                  <Fragment set:html={item.text} />
                </span>
              </li>
            ))}
          </ul>
        </div>
      );

    case "steps":
      return (
        <div data-reveal class="not-prose mt-10">
          {block.title && (
            <p class="mb-5 font-display text-lg text-brown sm:text-xl">{block.title}</p>
          )}
          <ol class="space-y-4">
            {block.steps.map((step, i) => (
              <li class="relative flex gap-4 rounded-2xl border border-brown/10 bg-cream-soft/70 p-5 sm:gap-5 sm:p-6">
                <span
                  class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full border border-gold/45 bg-cream font-display text-base text-honey-dark"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <span class="min-w-0">
                  <span class="block font-semibold text-brown">{step.title}</span>
                  <span class="mt-1.5 block text-[1.0625rem] leading-[1.7] text-brown/75">{step.text}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
      );

    /* Two renderings of one table. Phones get stacked cards, because a table
       that scrolls sideways is a bad answer on a 375px screen; from sm up the
       real table appears. Only one is in the accessibility tree at a time. */
    case "table":
      return (
        <div data-reveal class="not-prose mt-10">
          {block.caption && (
            <p class="mb-4 font-display text-lg text-brown sm:text-xl">{block.caption}</p>
          )}

          <div class="space-y-4 sm:hidden">
            {block.rows.map((row) => (
              <div class="overflow-hidden rounded-2xl border border-brown/12 bg-cream-soft/70">
                <p class="border-b border-brown/10 bg-brown/[0.04] px-4 py-3 font-semibold text-brown">
                  {row[0]}
                </p>
                <dl class="divide-y divide-brown/8">
                  {row.slice(1).map((cell, i) => (
                    <div class="px-4 py-3">
                      <dt class="text-[10px] font-bold uppercase tracking-[0.18em] text-brown/45">
                        {block.columns[i + 1]}
                      </dt>
                      <dd class="mt-1 leading-relaxed text-brown/80">{cell}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))}
          </div>

          <div class="hidden overflow-hidden rounded-2xl border border-brown/12 sm:block">
            <table class="w-full border-collapse text-start">
              <thead>
                <tr class="bg-brown/[0.05]">
                  {block.columns.map((col) => (
                    <th
                      scope="col"
                      class="px-5 py-3.5 text-start text-[10px] font-bold uppercase tracking-[0.18em] text-brown/55"
                    >
                      {col}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody class="divide-y divide-brown/8 bg-cream-soft/50">
                {block.rows.map((row) => (
                  <tr>
                    {row.map((cell, i) =>
                      i === 0 ? (
                        <th scope="row" class="px-5 py-4 text-start font-semibold text-brown">
                          {cell}
                        </th>
                      ) : (
                        <td class="px-5 py-4 leading-relaxed text-brown/80">{cell}</td>
                      )
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      );

    case "callout": {
      const tone = calloutTone[block.tone];
      return (
        <aside
          data-reveal
          class:list={["not-prose my-10 rounded-2xl border p-5 sm:p-6", tone.border, tone.bg]}
        >
          <p class="flex items-center gap-2.5 font-semibold text-brown">
            <span class:list={["h-1.5 w-1.5 flex-shrink-0 rounded-full", tone.dot]} aria-hidden="true"></span>
            {block.title}
          </p>
          <p
            class="mt-2.5 text-[1.0625rem] leading-[1.7] text-brown/80 [&_a]:font-semibold [&_a]:text-honey-dark [&_a]:underline [&_a]:decoration-gold/50 [&_a]:underline-offset-2 [&_a:hover]:decoration-honey-dark [&_strong]:font-semibold [&_strong]:text-brown"
            set:html={block.text}
          />
        </aside>
      );
    }

    case "ingredients":
      return (
        <div data-reveal class="not-prose mt-10">
          {block.title && (
            <p class="mb-5 font-display text-lg text-brown sm:text-xl">{block.title}</p>
          )}
          <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            {block.items.map((item) => (
              <li class="flex gap-4 rounded-2xl border border-brown/10 bg-cream-soft/70 p-4">
                <img
                  data-src={item.icon}
                  alt=""
                  aria-hidden="true"
                  width="224"
                  height="224"
                  decoding="async"
                  class="h-11 w-11 flex-shrink-0 object-contain"
                />
                <span class="min-w-0">
                  <span class="block font-semibold text-brown">{item.name}</span>
                  <span class="mt-1 block text-[0.9375rem] leading-[1.6] text-brown/70">{item.text}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      );

    case "quote":
      return (
        <figure data-reveal class="not-prose my-10 border-s-2 border-gold/60 ps-6">
          <blockquote class="font-display text-xl leading-relaxed text-brown sm:text-2xl">
            {block.text}
          </blockquote>
          {block.attribution && (
            <figcaption class="mt-3 text-sm text-brown/55">{block.attribution}</figcaption>
          )}
        </figure>
      );

    case "cta":
      return (
        <div
          data-reveal
          class="not-prose my-12 rounded-[1.75rem] border border-gold/30 bg-[linear-gradient(150deg,rgba(230,168,38,0.14),rgba(255,253,248,0.55))] p-7 text-center sm:p-9"
        >
          <p class="font-display text-2xl text-brown sm:text-3xl">{block.heading}</p>
          <p class="mx-auto mt-3 max-w-lg leading-relaxed text-brown/75">{block.text}</p>
          <a href={ctaHref} class="btn-primary mt-6 inline-flex">{block.label}</a>
        </div>
      );
  }
})}

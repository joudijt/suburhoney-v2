---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { LOCALES, SITE_URL, SITE_NAME, localeUrl, type Locale } from "../../../config/site";
import { ARTICLE_FIGURES } from "../../../config/articleFigures";
import { getArticles, getCanonicalSlug } from "../../../content/articles";

import en from "../../../i18n/locales/en/common.json";
import ar from "../../../i18n/locales/ar/common.json";
import ms from "../../../i18n/locales/ms/common.json";

const content = { en, ar, ms } as const;

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = content[lang];
const b = t.blog;
/* Each card shows its article's own lead image. Resolved through the canonical
   English slug because blog slugs are localized - same lookup the article page
   does. An article with no figure keeps the centred category icon. */
const articles = getArticles(lang).map((article) => {
  const canonical = getCanonicalSlug(lang, article.slug);
  return { article, figure: canonical ? ARTICLE_FIGURES[canonical] : undefined };
});
const blogUrl = localeUrl(lang, "/blog/");

const schemaGraph = [
  {
    "@type": "Blog",
    "@id": `${blogUrl}#blog`,
    name: b.heading,
    description: b.seoDescription,
    url: blogUrl,
    inLanguage: lang,
    publisher: { "@id": `${SITE_URL}/#organization` },
    blogPost: articles.map(({ article: a, figure }) => ({
      "@type": "BlogPosting",
      "@id": `${localeUrl(lang, `/blog/${a.slug}/`)}#article`,
      headline: a.title,
      description: a.description,
      datePublished: a.published,
      dateModified: a.updated,
      url: localeUrl(lang, `/blog/${a.slug}/`),
      ...(figure ? { image: [`${SITE_URL}${figure.src}`] } : {}),
    })),
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${blogUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: SITE_NAME, item: localeUrl(lang, "/") },
      { "@type": "ListItem", position: 2, name: b.heading, item: blogUrl },
    ],
  },
];
---

<Layout lang={lang} title={b.seoTitle} description={b.seoDescription} faqItems={[]} schemaGraph={schemaGraph}>
  <Header lang={lang} />
  <main>
    <section class="relative overflow-hidden bg-cream px-6 pb-24 pt-40 md:pb-32 md:pt-48" data-reveal-group>
      <div
        class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[60vmax] w-[60vmax] -translate-x-1/2 -translate-y-1/3 rounded-full bg-[radial-gradient(circle,rgba(230,168,38,0.16),transparent_65%)]"
        aria-hidden="true"
      >
      </div>

      <div class="mx-auto max-w-3xl space-y-5 text-center" data-reveal>
        <p class="kicker">{b.kicker}</p>
        <h1 class="font-display text-4xl text-brown md:text-6xl">{b.heading}</h1>
        <p class="mx-auto max-w-xl text-lg leading-relaxed text-brown/70">{b.subheading}</p>
      </div>

      <div class="mx-auto mt-16 grid max-w-6xl grid-cols-1 gap-8 md:grid-cols-3">
        {articles.map(({ article, figure }) => (
          <a
            data-reveal
            href={`/${lang}/blog/${article.slug}/`}
            class="group relative flex flex-col overflow-hidden rounded-3xl border border-brown/10 bg-cream-soft shadow-softer transition-all duration-500 hover:-translate-y-1.5 hover:border-gold/40 hover:shadow-soft"
          >
            <div class="relative flex h-44 items-center justify-center overflow-hidden bg-[linear-gradient(160deg,var(--color-sand),var(--color-cream-soft))] md:h-52">
              {figure ? (
                /* object-cover, not contain: the card band is a fixed height and
                   the figures are 4:3, so contain would letterbox every card.
                   Decorative here - the heading right below carries the same
                   meaning, so alt stays empty rather than repeating it. */
                <img
                  data-src={figure.src}
                  alt=""
                  aria-hidden="true"
                  width={figure.width}
                  height={figure.height}
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                <img
                  data-src={article.icon}
                  alt=""
                  aria-hidden="true"
                  width="224"
                  height="224"
                  decoding="async"
                  class="h-16 w-16 object-contain opacity-80 transition-transform duration-500 group-hover:scale-110 md:h-20 md:w-20"
                />
              )}
              <span class="absolute end-4 top-4 rounded-full bg-cream/85 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.15em] text-brown/60 backdrop-blur-sm">
                {article.category}
              </span>
            </div>

            <div class="flex flex-1 flex-col gap-3 p-7">
              <h2 class="font-display text-xl leading-snug text-brown transition-colors group-hover:text-honey-dark">
                {article.heading}
              </h2>
              <p class="text-[0.9375rem] leading-relaxed text-brown/70">{article.description}</p>
              <p class="mt-auto pt-2 text-xs text-brown/45">
                {article.readingMinutes} {b.readingMinutes}
              </p>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-16 flex justify-center" data-reveal>
        <a href={`/${lang}`} class="btn-secondary">{b.backHome}</a>
      </div>
    </section>
  </main>

  <Footer
    lang={lang}
    brand={t.footer.brand}
    description={t.footer.description}
    badges={t.footer.badges}
    shopHeading={t.footer.shopHeading}
    shopLinks={t.footer.shopLinks}
    blogKicker={t.footer.blogKicker}
    blogLink={t.footer.blogLink}
    copyright={t.footer.copyright}
    privacy={t.footer.privacy}
    terms={t.footer.terms}
  />
</Layout>

<script>
  import { initReveal } from "../../../scripts/reveal";
  initReveal();
</script>

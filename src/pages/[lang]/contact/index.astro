---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Blocks from "../../../components/article/Blocks.astro";
import { LOCALES, SITE_URL, SITE_NAME, BRAND_SELLER_URL, SHOPEE_URL, TIKTOK_SHOP_URL, INSTAGRAM_URL, FACEBOOK_URL, WHATSAPP_URL, localeUrl, type Locale } from "../../../config/site";

import en from "../../../i18n/locales/en/common.json";
import ar from "../../../i18n/locales/ar/common.json";
import ms from "../../../i18n/locales/ms/common.json";

import { page as enPage } from "../../../content/pages/en/contact";
import { page as arPage } from "../../../content/pages/ar/contact";
import { page as msPage } from "../../../content/pages/ms/contact";

const content = { en, ar, ms } as const;
const pages = { en: enPage, ar: arPage, ms: msPage } as const;

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = content[lang];
const cp = t.contactPage;
const doc = pages[lang];

const url = localeUrl(lang, "/contact/");

const schemaGraph = [
  {
    "@type": "Organization",
    "@id": `${SITE_URL}/#organization`,
    name: SITE_NAME,
    url: SITE_URL,
    logo: `${SITE_URL}/logo-8.webp`,
    sameAs: [BRAND_SELLER_URL],
  },
  {
    "@type": "ContactPage",
    "@id": `${url}#webpage`,
    name: doc.title,
    description: doc.description,
    url,
    inLanguage: lang,
    isPartOf: { "@id": `${SITE_URL}/#website` },
  },
  {
    "@type": "FAQPage",
    "@id": `${url}#faq`,
    mainEntity: doc.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: SITE_NAME, item: localeUrl(lang, "/") },
      { "@type": "ListItem", position: 2, name: doc.heading, item: url },
    ],
  },
];
---

<Layout
  lang={lang}
  title={doc.title}
  description={doc.description}
  faqItems={doc.faqs}
  schemaGraph={schemaGraph}
>
  <Header lang={lang} />

  <main>
    <article class="bg-cream">
      <header class="relative overflow-hidden pb-10 pt-32 md:pt-40">
        <div
          class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[52vmax] w-[52vmax] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(230,168,38,0.16),transparent_65%)]"
          aria-hidden="true"
        >
        </div>

        <!-- max-w-7xl + px-6/md:px-10 matches Header.astro and Footer.astro
             exactly, so this frame is the same width nav-to-footer; the
             text block inside is then centered within that fixed frame. -->
        <div class="mx-auto max-w-7xl px-6 md:px-10">
          <div class="mx-auto max-w-3xl text-center">
            <nav aria-label="Breadcrumb" class="mb-6 text-sm text-brown/55">
              <ol class="flex flex-wrap items-center justify-center gap-x-2">
                <li>
                  <a href={localeUrl(lang, "/")} class="inline-block py-1.5 hover:text-honey-dark">
                    {SITE_NAME}
                  </a>
                </li>
                <li aria-hidden="true">/</li>
                <li class="text-brown/75">{doc.heading}</li>
              </ol>
            </nav>

            <p class="kicker">{doc.category}</p>
            <h1 class="mt-4 font-display text-[2rem] leading-[1.18] text-brown sm:text-4xl md:text-5xl">
              {doc.heading}
            </h1>
            <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-brown/70">{doc.description}</p>
          </div>
        </div>
      </header>

      <!-- Real channels available today - see contact.ts: direct contact
           details are not live yet, so every card links somewhere real. -->
      <section data-reveal-group>
        <div class="mx-auto grid max-w-7xl grid-cols-1 items-start gap-14 px-6 pb-6 md:px-10 lg:grid-cols-2 lg:gap-24">
          <div class="space-y-4" data-reveal>
            <h2 class="font-display text-2xl text-brown sm:text-3xl">{cp.channelsHeading}</h2>
            <p class="text-brown/60">{cp.channelsSub}</p>

            <div class="mt-8 space-y-4">
              {[
                { href: SHOPEE_URL, title: cp.shopeeTitle, desc: cp.shopeeDesc },
                { href: TIKTOK_SHOP_URL, title: cp.tiktokTitle, desc: cp.tiktokDesc },
                { href: BRAND_SELLER_URL, title: cp.madinahTitle, desc: cp.madinahDesc },
              ].map((c) => (
                <a
                  href={c.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-start gap-4 rounded-2xl border border-brown/10 bg-cream-soft/70 p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-gold/40 hover:shadow-softer"
                >
                  <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-gold/15 text-honey-dark" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                      <path d="M15 3h6v6M10 14 21 3" />
                    </svg>
                  </span>
                  <span class="min-w-0">
                    <span class="block font-semibold text-brown group-hover:text-honey-dark">{c.title}</span>
                    <span class="mt-1 block text-[0.9375rem] leading-relaxed text-brown/65">{c.desc}</span>
                  </span>
                </a>
              ))}

              <a
                href={`/${lang}/#wholesale`}
                class="group flex items-start gap-4 rounded-2xl border border-brown/10 bg-cream-soft/70 p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-gold/40 hover:shadow-softer"
              >
                <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-gold/15 text-honey-dark" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 7h18M3 12h18M3 17h18" />
                  </svg>
                </span>
                <span class="min-w-0">
                  <span class="block font-semibold text-brown group-hover:text-honey-dark">{cp.wholesaleTitle}</span>
                  <span class="mt-1 block text-[0.9375rem] leading-relaxed text-brown/65">{cp.wholesaleDesc}</span>
                </span>
              </a>

              <a
                href={WHATSAPP_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-start gap-4 rounded-2xl border border-gold/25 bg-gold/[0.06] p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-gold/40 hover:shadow-softer"
              >
                <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-gold/15 text-honey-dark" aria-hidden="true">
                  <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path>
                  </svg>
                </span>
                <span class="min-w-0">
                  <span class="block font-semibold text-brown group-hover:text-honey-dark">{cp.whatsappTitle}</span>
                  <span class="mt-1 block text-[0.9375rem] leading-relaxed text-brown/65">{cp.whatsappDesc}</span>
                </span>
              </a>
            </div>

            <div class="pt-4">
              <span class="text-xs font-bold uppercase tracking-[0.3em] text-brown/50">{cp.followTitle}</span>
              <div class="mt-4 flex flex-wrap items-center gap-3">
                <a href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex h-11 w-11 items-center justify-center rounded-full border border-brown/15 text-brown/60 transition-colors hover:border-gold/40 hover:text-honey-dark">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"></path></svg>
                </a>
                <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex h-11 w-11 items-center justify-center rounded-full border border-brown/15 text-brown/60 transition-colors hover:border-gold/40 hover:text-honey-dark">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"></path></svg>
                </a>
                <a href={SHOPEE_URL} target="_blank" rel="noopener noreferrer" aria-label="Shopee" class="flex h-11 w-11 items-center justify-center rounded-full border border-brown/15 text-brown/60 transition-colors hover:border-gold/40 hover:text-honey-dark">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.9414 17.9633c.229-1.879-.981-3.077-4.1758-4.0969-1.548-.528-2.277-1.22-2.26-2.1719.065-1.056 1.048-1.825 2.352-1.85a5.2898 5.2898 0 0 1 2.8838.89c.116.072.197.06.263-.039.09-.145.315-.494.39-.62.051-.081.061-.187-.068-.281-.185-.1369-.704-.4149-.983-.5319a6.4697 6.4697 0 0 0-2.5118-.514c-1.909.008-3.4129 1.215-3.5389 2.826-.082 1.1629.494 2.1078 1.73 2.8278.262.152 1.6799.716 2.2438.892 1.774.552 2.695 1.5419 2.478 2.6969-.197 1.047-1.299 1.7239-2.818 1.7439-1.2039-.046-2.2878-.537-3.1278-1.19l-.141-.11c-.104-.08-.218-.075-.287.03-.05.077-.376.547-.458.67-.077.108-.035.168.045.234.35.293.817.613 1.134.775a6.7097 6.7097 0 0 0 2.8289.727 4.9048 4.9048 0 0 0 2.0759-.354c1.095-.465 1.8029-1.394 1.9449-2.554zM11.9986 1.4009c-2.068 0-3.7539 1.95-3.8329 4.3899h7.6657c-.08-2.44-1.765-4.3899-3.8328-4.3899zm7.8516 22.5981-.08.001-15.7843-.002c-1.074-.04-1.863-.91-1.971-1.991l-.01-.195L1.298 6.2858a.459.459 0 0 1 .45-.494h4.9748C6.8448 2.568 9.1607 0 11.9996 0c2.8388 0 5.1537 2.5689 5.2757 5.7898h4.9678a.459.459 0 0 1 .458.483l-.773 15.5883-.007.131c-.094 1.094-.979 1.9769-2.0709 2.0059z"></path></svg>
                </a>
                <a href={TIKTOK_SHOP_URL} target="_blank" rel="noopener noreferrer" aria-label="TikTok Shop" class="flex h-11 w-11 items-center justify-center rounded-full border border-brown/15 text-brown/60 transition-colors hover:border-gold/40 hover:text-honey-dark">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path></svg>
                </a>
              </div>
            </div>
          </div>

          <div class="rounded-3xl border border-white/10 bg-brown p-8 text-cream-soft shadow-2xl md:p-12" data-reveal>
            <h2 class="mb-2 font-display text-2xl md:text-3xl">{cp.formHeading}</h2>
            <p class="mb-8 text-cream-soft/60">{cp.formSub}</p>
            <form class="space-y-6" data-whatsapp-form data-whatsapp-heading={t.whatsapp.contactHeading}>
              <div class="space-y-2">
                <label class="text-[10px] font-bold uppercase tracking-widest opacity-60">{cp.formFullName}</label>
                <input type="text" placeholder={cp.formFullNamePlaceholder} class="w-full rounded-xl border border-brown/10 bg-cream-soft px-5 py-4 text-brown outline-none transition-all placeholder:text-brown/35 focus:border-gold" />
              </div>
              <div class="space-y-2">
                <label class="text-[10px] font-bold uppercase tracking-widest opacity-60">{cp.formEmail}</label>
                <input type="email" placeholder={cp.formEmailPlaceholder} class="w-full rounded-xl border border-brown/10 bg-cream-soft px-5 py-4 text-brown outline-none transition-all placeholder:text-brown/35 focus:border-gold" />
              </div>
              <div class="space-y-2">
                <label class="text-[10px] font-bold uppercase tracking-widest opacity-60">{cp.formSubject}</label>
                <select class="w-full cursor-pointer appearance-none rounded-xl border border-brown/10 bg-cream-soft px-5 py-4 text-brown outline-none transition-all focus:border-gold">
                  {cp.formSubjectOptions.map((opt: string) => <option>{opt}</option>)}
                </select>
              </div>
              <div class="space-y-2">
                <label class="text-[10px] font-bold uppercase tracking-widest opacity-60">{cp.formMessage}</label>
                <textarea rows="4" placeholder={cp.formMessagePlaceholder} class="w-full resize-none rounded-xl border border-brown/10 bg-cream-soft px-5 py-4 text-brown outline-none transition-all placeholder:text-brown/35 focus:border-gold"></textarea>
              </div>
              <button type="submit" class="w-full rounded-xl bg-gold py-5 font-bold uppercase tracking-[0.2em] text-cream-soft shadow-xl shadow-gold/20 transition-all hover:brightness-110">
                {cp.formSend}
              </button>
            </form>
          </div>
        </div>
      </section>

      <div class="pb-4" data-reveal-group>
        <div class="mx-auto max-w-7xl px-6 md:px-10">
          <div class="mx-auto max-w-3xl">
            <Blocks blocks={doc.blocks} ctaHref={`/${lang}/retail/`} />
          </div>
        </div>
      </div>

      <section aria-labelledby="faq-heading" class="py-14" data-reveal-group>
        <div class="mx-auto max-w-7xl px-6 md:px-10">
          <div class="mx-auto max-w-3xl">
            <h2 id="faq-heading" class="text-center font-display text-2xl text-brown sm:text-3xl md:text-4xl" data-reveal>
              {t.blog.faqHeading}
            </h2>
            <div class="mt-7 space-y-3">
              {doc.faqs.map((faq) => (
                <details
                  data-reveal
                  class="group overflow-hidden rounded-2xl border border-brown/10 bg-cream-soft/70 transition-colors open:border-gold/40"
                >
                  <summary
                    class="flex cursor-pointer list-none items-start justify-between gap-4 p-5 font-semibold text-brown marker:hidden sm:p-6"
                  >
                    <span>{faq.q}</span>
                    <span
                      class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-brown/20 text-brown/60 transition-transform duration-300 group-open:rotate-45"
                      aria-hidden="true"
                    >
                      +
                    </span>
                  </summary>
                  <p
                    class="px-5 pb-5 leading-[1.75] text-brown/80 sm:px-6 sm:pb-6 [&_a]:font-semibold [&_a]:text-honey-dark [&_a]:underline"
                    set:html={faq.a}
                  />
                </details>
              ))}
            </div>
          </div>
        </div>
      </section>
    </article>
  </main>

  <Footer
    lang={lang}
    brand={t.footer.brand}
    description={t.footer.description}
    badges={t.footer.badges}
    shopHeading={t.footer.shopHeading}
    shopLinks={t.footer.shopLinks}
    blogKicker={t.footer.blogKicker}
    blogLink={t.footer.blogLink}
    copyright={t.footer.copyright}
    privacy={t.footer.privacy}
    terms={t.footer.terms}
  />
</Layout>

<script>
  import { initReveal } from "../../../scripts/reveal";
  initReveal();
</script>

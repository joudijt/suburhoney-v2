---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Blocks from "../../../components/article/Blocks.astro";
import { LOCALES, SITE_URL, SITE_NAME, BRAND_SELLER, BRAND_SELLER_URL, BRANCHES, SHOPEE_URL, TIKTOK_SHOP_URL, WHATSAPP_URL, localeUrl, type Locale } from "../../../config/site";
import { SELLER_ID, STORE_NODES, branchId } from "../../../config/schema";
import en from "../../../i18n/locales/en/common.json";
import ar from "../../../i18n/locales/ar/common.json";
import ms from "../../../i18n/locales/ms/common.json";

import { page as enPage } from "../../../content/pages/en/retail";
import { page as arPage } from "../../../content/pages/ar/retail";
import { page as msPage } from "../../../content/pages/ms/retail";

const content = { en, ar, ms } as const;
const pages = { en: enPage, ar: arPage, ms: msPage } as const;

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = content[lang];
const doc = pages[lang];
/* Group headings, the WhatsApp labels and the branch area names, read from the
   same `storeModal` keys StoreModal.astro uses so the hero and the sitewide
   panel cannot drift apart. Areas are keyed by `Branch.id`. */
const s = { ...t.storeModal, branchAreas: t.storeModal.branchAreas as Record<string, string> };

const url = localeUrl(lang, "/retail/");

const schemaGraph = [
  {
    "@type": "Organization",
    "@id": `${SITE_URL}/#organization`,
    name: SITE_NAME,
    url: SITE_URL,
    logo: `${SITE_URL}/logo-8.webp`,
    sameAs: [BRAND_SELLER_URL],
  },
  {
    "@type": "CollectionPage",
    "@id": `${url}#webpage`,
    name: doc.title,
    description: doc.description,
    url,
    inLanguage: lang,
    isPartOf: { "@id": `${SITE_URL}/#website` },
  },
  /* One seller, several ways to reach it. The list used to name Shopee, TikTok
     Shop and Berkat Madinah as three peer retailers, which contradicts the page
     itself: both storefronts belong to the store. See FORGE-SPEC D1. */
  ...STORE_NODES,
  {
    "@type": "ItemList",
    "@id": `${url}#retailers`,
    name: `Ways to buy Subur Honey from ${BRAND_SELLER}`,
    itemListElement: [
      ...BRANCHES.map((branch, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: { "@id": branchId(branch.id) },
      })),
      {
        "@type": "ListItem",
        position: BRANCHES.length + 1,
        item: { "@type": "OnlineStore", name: `${BRAND_SELLER} on Shopee`, url: SHOPEE_URL, parentOrganization: { "@id": SELLER_ID } },
      },
      {
        "@type": "ListItem",
        position: BRANCHES.length + 2,
        item: { "@type": "OnlineStore", name: `${BRAND_SELLER} on TikTok Shop`, url: TIKTOK_SHOP_URL, parentOrganization: { "@id": SELLER_ID } },
      },
    ],
  },
  {
    "@type": "FAQPage",
    "@id": `${url}#faq`,
    mainEntity: doc.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: SITE_NAME, item: localeUrl(lang, "/") },
      { "@type": "ListItem", position: 2, name: doc.heading, item: url },
    ],
  },
];
---

<Layout
  lang={lang}
  title={doc.title}
  description={doc.description}
  faqItems={doc.faqs}
  schemaGraph={schemaGraph}
>
  <Header lang={lang} />

  <main>
    <article class="bg-cream">
      <header class="relative overflow-hidden pb-10 pt-32 md:pt-40">
        <div
          class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[52vmax] w-[52vmax] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(230,168,38,0.16),transparent_65%)]"
          aria-hidden="true"
        >
        </div>

        <!-- max-w-7xl + px-6/md:px-10 matches Header.astro and Footer.astro
             exactly, so this frame is the same width nav-to-footer; the
             text block inside is then centered within that fixed frame. -->
        <div class="mx-auto max-w-7xl px-6 md:px-10">
          <div class="mx-auto max-w-3xl text-center">
            <nav aria-label="Breadcrumb" class="mb-6 text-sm text-brown/55">
              <ol class="flex flex-wrap items-center justify-center gap-x-2">
                <li>
                  <a href={localeUrl(lang, "/")} class="inline-block py-1.5 hover:text-honey-dark">
                    {SITE_NAME}
                  </a>
                </li>
                <li aria-hidden="true">/</li>
                <li class="text-brown/75">{doc.heading}</li>
              </ol>
            </nav>

            <p class="kicker">{doc.category}</p>
            <h1 class="mt-4 font-display text-[2rem] leading-[1.18] text-brown sm:text-4xl md:text-5xl">
              {doc.heading}
            </h1>
            <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-brown/70">{doc.description}</p>

            {/* One retailer, four ways to buy - FORGE-SPEC D1/C4, the same
                grouping as StoreModal.astro. This used to be three equal
                buttons, which read as three peer sellers and contradicted the
                paragraph directly above it. Shopee and TikTok Shop are the one
                store's two storefronts, the two branches are the other two
                ways, and WhatsApp is a contact line rather than a shop. The
                addresses come from BRANCHES - never retyped here. */}
            <div class="mx-auto mt-8 max-w-xl rounded-2xl border border-brown/10 bg-cream-soft/70 p-5 text-start shadow-softer sm:p-6">
              <section aria-labelledby="retail-online-heading">
                <p id="retail-online-heading" class="kicker">{s.onlineHeading}</p>
                <div class="mt-3 flex flex-wrap gap-3">
                  <a
                    href={SHOPEE_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-primary px-7 py-3 normal-case tracking-normal"
                  >
                    {t.storeModal.shopee}
                  </a>
                  <a
                    href={TIKTOK_SHOP_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-secondary px-7 py-3 normal-case tracking-normal"
                  >
                    {t.storeModal.tiktok}
                  </a>
                </div>
              </section>

              <section class="mt-6" aria-labelledby="retail-branches-heading">
                <p id="retail-branches-heading" class="kicker">{s.branchesHeading}</p>
                <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                  {BRANCHES.map((branch) => (
                    <li class="rounded-xl border border-brown/15 bg-cream px-4 py-3">
                      <p class="font-semibold text-brown">{s.branchAreas[branch.id] ?? branch.area}</p>
                      {/* The address stays Latin script in every locale, so it
                          is isolated rather than translated - an un-isolated
                          Latin address inside RTL prose reorders its own
                          comma-separated parts. */}
                      <p class="mt-1 text-sm leading-relaxed text-brown/70">
                        <bdi dir="ltr">{branch.full}</bdi>
                      </p>
                    </li>
                  ))}
                </ul>
              </section>

              <div class="mt-6 border-t border-brown/10 pt-4">
                <a
                  href={WHATSAPP_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-semibold text-honey-dark underline underline-offset-4 transition hover:text-brown"
                >
                  {s.contactLabel}
                </a>
                <p class="mt-1 text-sm text-brown/60">{s.contactHint}</p>
                <a
                  href={BRAND_SELLER_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-block text-sm text-brown/60 underline underline-offset-4 transition hover:text-honey-dark"
                >
                  {t.storeModal.madinah}
                </a>
              </div>
            </div>
          </div>
        </div>
      </header>

      <div data-reveal-group>
        <div class="mx-auto max-w-7xl px-6 md:px-10">
          <div
            data-reveal
            class="relative mx-auto max-w-3xl overflow-hidden rounded-[1.75rem] border border-gold/30 bg-[linear-gradient(135deg,rgba(230,168,38,0.14),rgba(255,253,248,0.6))] p-6 text-center shadow-softer sm:p-8"
          >
            <div
              class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-[radial-gradient(circle,rgba(230,168,38,0.35),transparent_70%)]"
              aria-hidden="true"
            >
            </div>

            {/* Jar on the physical left, copy on the physical right, in every
                locale. `flex-row-reverse` under RTL is what pins it there: with
                plain `row`, RTL would put the first child on the right and swing
                the jar across. The bare transparent jar is used rather than the
                page-retail composite - that file's cream backdrop inside this
                already-tinted box read as a box within a box. */}
            <div
              class={`relative md:flex md:items-center md:gap-8 ${
                lang === "ar" ? "md:flex-row-reverse" : "md:flex-row"
              }`}
            >
              <img
                src="/jarncap.webp"
                alt={doc.figureAlt}
                width="400"
                height="639"
                loading="lazy"
                decoding="async"
                class="mx-auto h-auto w-40 flex-shrink-0 drop-shadow-xl sm:w-48 md:mx-0 md:w-[34%]"
              />

              <div class="mt-6 md:mt-0 md:text-start">
                <span class="kicker inline-flex items-center gap-1.5">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l1.9 5.8L20 9l-5.8 1.9L12 17l-1.9-6.1L4 9l6.1-1.2z" />
                  </svg>
                  {t.launchTeaser.badge}
                </span>
                <p class="mx-auto mt-3 max-w-xl font-display text-2xl leading-snug text-brown sm:text-3xl md:mx-0">
                  {t.launchTeaser.heading}
                </p>
                <p class="mx-auto mt-3 max-w-xl leading-relaxed text-brown/70 md:mx-0">{t.launchTeaser.text}</p>
                <a
                  href={SHOPEE_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-secondary mt-6 inline-flex rounded-xl normal-case tracking-normal"
                >
                  {t.launchTeaser.cta}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="pb-4" data-reveal-group>
        <div class="mx-auto max-w-7xl px-6 md:px-10">
          <div class="mx-auto max-w-3xl">
            {/* No standalone lead figure here any more - the jar moved up into
                the launch-teaser box above, so a second copy of it directly
                underneath would just repeat the same product shot. */}
            <Blocks blocks={doc.blocks} ctaHref={`/${lang}/benefits/`} />
          </div>
        </div>
      </div>

      <section aria-labelledby="faq-heading" class="py-14" data-reveal-group>
        <div class="mx-auto max-w-7xl px-6 md:px-10">
          <div class="mx-auto max-w-3xl">
            <h2 id="faq-heading" class="text-center font-display text-2xl text-brown sm:text-3xl md:text-4xl" data-reveal>
              {t.blog.faqHeading}
            </h2>
            <div class="mt-7 space-y-3">
              {doc.faqs.map((faq) => (
                <details
                  data-reveal
                  class="group overflow-hidden rounded-2xl border border-brown/10 bg-cream-soft/70 transition-colors open:border-gold/40"
                >
                  <summary
                    class="flex cursor-pointer list-none items-start justify-between gap-4 p-5 font-semibold text-brown marker:hidden sm:p-6"
                  >
                    <span>{faq.q}</span>
                    <span
                      class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-brown/20 text-brown/60 transition-transform duration-300 group-open:rotate-45"
                      aria-hidden="true"
                    >
                      +
                    </span>
                  </summary>
                  <p
                    class="px-5 pb-5 leading-[1.75] text-brown/80 sm:px-6 sm:pb-6 [&_a]:font-semibold [&_a]:text-honey-dark [&_a]:underline"
                    set:html={faq.a}
                  />
                </details>
              ))}
            </div>
          </div>
        </div>
      </section>
    </article>
  </main>

  <Footer
    lang={lang}
    brand={t.footer.brand}
    description={t.footer.description}
    badges={t.footer.badges}
    shopHeading={t.footer.shopHeading}
    shopLinks={t.footer.shopLinks}
    blogKicker={t.footer.blogKicker}
    blogLink={t.footer.blogLink}
    copyright={t.footer.copyright}
    privacy={t.footer.privacy}
    terms={t.footer.terms}
  />
</Layout>

<script>
  import { initReveal } from "../../../scripts/reveal";
  initReveal();
</script>

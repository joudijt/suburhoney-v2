---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import CursorBee from "../components/CursorBee.astro";
import StoreModal from "../components/StoreModal.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { LOCALE_META, type Locale } from "../config/site";

import en from "../i18n/locales/en/common.json";
import ar from "../i18n/locales/ar/common.json";
import ms from "../i18n/locales/ms/common.json";

const content = { en, ar, ms } as const;

interface Props {
  lang: Locale;
  title: string;
  description: string;
  faqItems: { q: string; a: string }[];
  /** Article pages override these; see SEO.astro for why each exists. */
  alternates?: Partial<Record<Locale, string>>;
  schemaGraph?: unknown[];
  articleMeta?: { published: string; updated: string; section?: string; tags?: string[] };
  image?: string;
}

const { lang, title, description, faqItems, alternates, schemaGraph, articleMeta, image } =
  Astro.props;
const dir = LOCALE_META[lang].dir;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <SEO
      lang={lang}
      title={title}
      description={description}
      faqItems={faqItems}
      alternates={alternates}
      schemaGraph={schemaGraph}
      articleMeta={articleMeta}
      image={image}
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-cream text-ink font-body antialiased">
    <slot />
    <CursorBee />
    <StoreModal lang={lang} />
    <WhatsAppButton label={content[lang].whatsapp.label} />

    <script>
      import { initDeferredImages } from "../scripts/deferred-images";
      initDeferredImages();
    </script>
    <script>
      import { initFormsToWhatsApp } from "../scripts/form-to-whatsapp";
      import { WHATSAPP_NUMBER } from "../config/site";
      initFormsToWhatsApp(WHATSAPP_NUMBER);
    </script>
  </body>
</html>
